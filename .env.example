# Copy to .env before `docker compose up`. docker-compose falls back to these same defaults,
# so a plain `docker compose up --build` works without this file.

# Shared secret guarding the /api/internal routes on both services.
INTERNAL_TOKEN=local-dev-internal-token

# Postgres credentials, applied to both (separate) database containers.
POSTGRES_USER=fiapsub
POSTGRES_PASSWORD=fiapsub

# Where core-api pushes catalogue changes. Uncomment when sales runs on the host via `dotnet run`.
# SALES_SERVICE_URL=http://host.docker.internal:8081
